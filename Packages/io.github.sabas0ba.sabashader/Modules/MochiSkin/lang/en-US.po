msgid ""
msgstr ""
"Language: en-US\n"

msgid "__MochiSkin"
msgstr "Mochi Skin"

msgid "__Amount"
msgstr "Amount"

msgid "__AmountDesc"
msgstr "0 disables deformation; 1 applies the configured depth and normal response."

msgid "__UVChannel"
msgstr "UV Channel"

msgid "__UVChannelDesc"
msgstr "The UV channel used to place all four contact points."

msgid "__Depth"
msgstr "Depth"

msgid "__DepthDesc"
msgstr "Maximum inward vertex displacement in world units at pressure 1."

msgid "__Bulge"
msgstr "Outer Bulge"

msgid "__BulgeDesc"
msgstr "Height of the soft raised ring around each depression relative to Depth."

msgid "__IndentSpread"
msgstr "Indent Spread"

msgid "__IndentSpreadDesc"
msgstr "Fraction of the contact footprint used by the central depression. Lower values leave a wider cushion rim."

msgid "__EdgeSoftness"
msgstr "Edge Softness"

msgid "__EdgeSoftnessDesc"
msgstr "Widens the transition from the depression through the rim to the unaffected surface."

msgid "__Irregularity"
msgstr "Contour Irregularity"

msgid "__IrregularityDesc"
msgstr "Applies a low-frequency distortion to avoid a perfectly regular concentric contour."

msgid "__IrregularityScale"
msgstr "Irregularity Scale"

msgid "__IrregularityScaleDesc"
msgstr "Frequency of the low-frequency contour distortion."

msgid "__ContactThreshold"
msgstr "Contact Threshold"

msgid "__ContactThresholdDesc"
msgstr "Ignores Proximity below this value so deformation begins at physical contact instead of at receiver range entry."

msgid "__ContactSoftness"
msgstr "Contact Softness"

msgid "__ContactSoftnessDesc"
msgstr "Controls the response curve from Contact Threshold to maximum pressure. One gives a smooth response at both ends."

msgid "__NormalStrength"
msgstr "Normal Strength"

msgid "__NormalStrengthDesc"
msgstr "Scales the tangent-space normal response without changing the silhouette."

msgid "__Point0"
msgstr "Contact Point 0"

msgid "__Point1"
msgstr "Contact Point 1"

msgid "__Point2"
msgstr "Contact Point 2"

msgid "__Point3"
msgstr "Contact Point 3"

msgid "__Point"
msgstr "Center XY / Radius ZW"

msgid "__PointDesc"
msgstr "UV center in XY and contact footprint radius in ZW."

msgid "__Shape"
msgstr "Angle / Shape Exponent / Seed / Reserved"

msgid "__ShapeDesc"
msgstr "X is the UV angle. Y is the shape exponent: 2 is elliptical and higher values approach a rounded plate. Z is the contour seed."

msgid "__Pressure"
msgstr "Pressure"

msgid "__PressureDesc"
msgstr "Proximity from 0 to 1. Animate this material property from a Contact Receiver; values below Contact Threshold do not deform."
