msgid ""
msgstr ""
"Language: ja-JP\n"

msgid "__Transition"
msgstr "登場・退場transition"

msgid "__Progress"
msgstr "進行度"

msgid "__ProgressDesc"
msgstr "Animation Controllerから駆動します。0が初期状態、1が完全な表示・solid状態です。"

msgid "__Mode"
msgstr "方式"

msgid "__ModeDesc"
msgstr "上方向dissolve、glitch spawn、liquid-to-solidから選択します。"

msgid "__Direction"
msgstr "方向"

msgid "__DirectionDesc"
msgstr "object-spaceの進行方向です。XYZのみ使用します。"

msgid "__Bounds"
msgstr "高さ範囲"

msgid "__BoundsDesc"
msgstr "方向軸上の最小値と最大値です。XYのみ使用します。"

msgid "__NoiseScale"
msgstr "noise scale"

msgid "__NoiseScaleDesc"
msgstr "dissolve境界に使うobject-space noiseの密度です。"

msgid "__Noise"
msgstr "noise"

msgid "__NoiseDesc"
msgstr "dissolve境界の乱れです。進行度0と1では自動的に0になります。"

msgid "__EdgeWidth"
msgstr "edge幅"

msgid "__EdgeWidthDesc"
msgstr "表示境界へ発光色を加える幅です。"

msgid "__EdgeColor"
msgstr "edge色"

msgid "__EdgeColorDesc"
msgstr "表示境界のHDR発光色です。アルファを強度へ掛けます。"

msgid "__EdgeEmission"
msgstr "edge発光"

msgid "__EdgeEmissionDesc"
msgstr "ライトに依存しない境界色の明るさです。"

msgid "__Displacement"
msgstr "分解変位"

msgid "__DisplacementDesc"
msgstr "dissolveとglitchで頂点を移動するobject-space量です。"

msgid "__BlockScale"
msgstr "glitch block密度"

msgid "__BlockScaleDesc"
msgstr "glitch spawnの表示判定と頂点変位をまとめるcell密度です。"

msgid "__Liquid"
msgstr "Liquid to Solid"

msgid "__LiquidAmplitude"
msgstr "液体変形"

msgid "__LiquidAmplitudeDesc"
msgstr "進行度0での頂点波形と沈み込みの量です。"

msgid "__LiquidFrequency"
msgstr "波の密度"

msgid "__LiquidFrequencyDesc"
msgstr "object-space上の液体波形の周波数です。"

msgid "__LiquidSpeed"
msgstr "波の速度"

msgid "__LiquidSpeedDesc"
msgstr "液体波形の時間変化速度です。"

msgid "__LiquidWobble"
msgstr "不規則な揺れ"

msgid "__LiquidWobbleDesc"
msgstr "異なる方向と周波数の波を合成し、液体変形を不規則にします。1を超えると変形量も増加します。"

msgid "__LiquidPuddle"
msgstr "初期状態を水たまりにする"

msgid "__LiquidPuddleDesc"
msgstr "進行度0でmeshを方向軸の下端へ圧縮し、水平方向へ広げます。"

msgid "__LiquidPuddleHeight"
msgstr "水たまりの厚さ"

msgid "__LiquidPuddleHeightDesc"
msgstr "高さ範囲に対する水たまりの厚さです。Boundsの最小値が接地面になります。"

msgid "__LiquidPuddleSpread"
msgstr "水たまりの広がり"

msgid "__LiquidPuddleSpreadDesc"
msgstr "方向軸に直交する面へmeshを広げるobject-space比率です。"

msgid "__LiquidTint"
msgstr "液体色"

msgid "__LiquidTintDesc"
msgstr "RGBを元のalbedoへ乗算し、アルファを進行度0での合成率へ使用します。"
