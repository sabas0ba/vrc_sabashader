msgid ""
msgstr ""
"Language: en-US\n"

msgid "__SurfaceOverlay"
msgstr "Surface Overlay"

msgid "__Amount"
msgstr "Amount"

msgid "__AmountDesc"
msgstr "0 disables it. Rain, sweat, snow and dirt share this single control."

msgid "__Texture"
msgstr "Overlay Texture"

msgid "__TextureDesc"
msgstr "Pattern for dirt or snow. Multiplied by the color below."

msgid "__Color"
msgstr "Overlay Color (alpha controls color replacement; 0 for rain and sweat)"

msgid "__MaskChannel"
msgstr "Mask Channel"

msgid "__MaskChannelDesc"
msgstr "Which channel of the shared mask to use. None covers everything."

msgid "__UpBias"
msgstr "Upward Bias"

msgid "__UpBiasDesc"
msgstr "Higher values restrict the overlay to upward facing surfaces."

msgid "__Border"
msgstr "Border"

msgid "__BorderDesc"
msgstr "How much coverage is needed. Higher values shrink the area."

msgid "__Blur"
msgstr "Border Blur"

msgid "__Darken"
msgstr "Wet Darkening"

msgid "__DarkenDesc"
msgstr "Darkens the base color where covered. Use for rain and sweat."

msgid "__Flatten"
msgstr "Settled Roundness"

msgid "__FlattenDesc"
msgstr "Tilts the normal upward where covered. Use for settled snow."

msgid "__Thickness"
msgstr "Settled Thickness"

msgid "__ThicknessDesc"
msgstr "Pushes vertices out to give the layer thickness, in meters. Changes the silhouette, so keep it small."

msgid "__VertexMaskChannel"
msgstr "Vertex Color Mask"

msgid "__VertexMaskChannelDesc"
msgstr "Vertex color channel that limits the thickness. Textures cannot be sampled in a vertex shader, so the mask comes from vertex colors."

msgid "__Droplet"
msgstr "Droplets"

msgid "__DropletDesc"
msgstr "Water beads on the surface. This is what makes it read as wet."

msgid "__DropletScale"
msgstr "Droplet Density"

msgid "__DropletBump"
msgstr "Droplet Bump"

msgid "__DropletBumpDesc"
msgstr "Perturbs the normal per droplet so the body's specular lights them up. At 0 it will not look wet."

msgid "__Streak"
msgstr "Streaks"

msgid "__StreakDesc"
msgstr "Shapes the coverage into vertical running streaks. Use for rain drips and sweat."

msgid "__StreakScale"
msgstr "Streak Density"

msgid "__StreakSpeed"
msgstr "Streak Speed"
