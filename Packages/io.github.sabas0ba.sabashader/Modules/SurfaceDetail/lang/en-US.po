msgstr "Variation applied to roughness and the micro specular response."

msgid "__Skin"
msgstr "Skin"

msgid "__Pore"
msgstr "Pores"

msgid "__PoreDesc"
msgstr "Depth of the procedural pores."

msgid "__Fabric"
msgstr "Fabric"

msgid "__Weave"
msgstr "Weave"

msgid "__WeaveDesc"
msgstr "Relief of the alternating warp and weft threads."

msgid "__Sheen"
msgstr "Sheen"

msgid "__SheenDesc"
msgstr "Strength of skin micro specular or fabric grazing sheen."

