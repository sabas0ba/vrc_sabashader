msgid "__SurfaceDetail"
msgstr "Surface Micro Detail"

msgid "__Amount"
msgstr "Amount"

msgid "__AmountDesc"
msgstr "0 disables the module; 1 applies the configured micro detail."

msgid "__Mode"
msgstr "Material"

msgid "__ModeDesc"
msgstr "Select skin pores or fabric weave with grazing sheen."

msgid "__Texture"
msgstr "Detail Texture"

msgid "__TextureDesc"
msgstr "RGB adds color variation and RG adds an optional micro normal."

msgid "__TextureStrength"
msgstr "Texture Strength"

msgid "__TextureStrengthDesc"
