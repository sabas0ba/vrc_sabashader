Shader "SabaShader/Paper2D"
{
    Properties
    {
        __SC_SHADERLAB_properties__
        [SCHide]_ShaderLabDummy("", Float) = 0
    }

    SubShader
    {
        Tags
        {
            "RenderType" = "Opaque"
            "Queue" = "Geometry"
            "VRCFallback" = "Toon"
        }

        Pass
        {
            Name "FORWARD"
            Tags { "LightMode" = "ForwardBase" }
            Cull [_Cull]
            ZWrite On

            HLSLPROGRAM
            #pragma target 3.5
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_forward.hlsl"
            #include "../Thin2D/Thin2DLighting.hlsl"
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_lighting.hlsl"
            #include "Paper2DFragment.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "WHITE_BORDER"
            Tags { "LightMode" = "ForwardBase" }
            Cull Front
            ZWrite Off

            HLSLPROGRAM
            #pragma target 3.5
            #define SBS_PASS_BORDER
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_forward.hlsl"
            #include "Paper2DBorderFragment.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "OUTLINE"
            Tags { "LightMode" = "ForwardBase" }
            Cull Front
            ZWrite On

            HLSLPROGRAM
            #pragma target 3.5
            #define SBS_PASS_OUTLINE
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_forward.hlsl"
            #include "Paper2DOutlineFragment.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "FORWARD_DELTA"
            Tags { "LightMode" = "ForwardAdd" }
            Cull [_Cull]
            ZWrite Off
            Blend One One

            HLSLPROGRAM
            #pragma target 3.5
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_forwardadd.hlsl"
            #include "../Thin2D/Thin2DLighting.hlsl"
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_lighting.hlsl"
            #include "Paper2DFragment.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "SHADOW_CASTER"
            Tags { "LightMode" = "ShadowCaster" }
            Cull [_Cull]
            ZWrite On

            HLSLPROGRAM
            #pragma target 3.5
            #define SBS_PASS_SHADOW
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_shadowcaster.hlsl"
            ENDHLSL
        }
    }

    CustomEditor "SCMaterialEditor"
}
